# =====================================================================
# Smart Disaster Management & Emergency Response System
# Environment Configuration Template (.env.example)
# Placeholders only - Never commit real credentials to version control.
# =====================================================================

# ---------------------------------------------------------------------
# Aiven Cloud MySQL Connection URI (Mandatory)
# Format: mysql://<user>:<password>@<host>:<port>/<database>?ssl-mode=REQUIRED
# Obtain directly from the Aiven Console Overview: "Service URI"
# ---------------------------------------------------------------------
DATABASE_URL=mysql://avnadmin:your_secure_password_here@mysql-your-project.aivencloud.com:15432/defaultdb?ssl-mode=REQUIRED

# ---------------------------------------------------------------------
# Optional Aiven SSL/TLS Certificate Settings
# (Aiven default certificates work automatically without specifying a path)
# ---------------------------------------------------------------------
# AIVEN_CA_CERT=/path/to/ca.pem
DB_SSL_VERIFY_IDENTITY=true
DB_POOL_SIZE=5

# ---------------------------------------------------------------------
# Flask Backend Configuration
# ---------------------------------------------------------------------
SECRET_KEY=change-this-to-a-cryptographically-random-32-byte-string-in-production
PORT=5000
FLASK_ENV=development

# ---------------------------------------------------------------------
# CORS & Allowed Frontend Origins (Comma-separated for multiple domains)
# Local: http://localhost:5173
# Production example: https://smart-disaster-resq.vercel.app,http://localhost:5173
# ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Production Session Cookie Settings (Automated when FLASK_ENV=production)
# ---------------------------------------------------------------------
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
